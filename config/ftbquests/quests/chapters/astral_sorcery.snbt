	quest_links: [ ]
	quests: [
		{
			description: [
				"从星芒宝典的“发现”页开始。宝典以研究进度开放内容，本章按实际手册分成发现、探索、共鸣、星座、五彩。"
				"任务物品仅检查取得，不消耗；手动勾选只代表你确认完成实作，不自动检测研究或结构。升级祭坛会原地替换，请先完成前一级目标，必要时挖下新祭坛供背包检测后再放回。"
				"地图上排从左向右，下排从右向左。各区入口需要对应阶段设备；箭头是局部学习顺序，不是完整配方表。"
				""
				"手册阶段：A 发现；参照页面：WELCOME。"
			]
			icon: "astralsorcery:tome"
			id: "383340D9B0A5E896"
			rewards: [{
				id: "24EA71B1BD41F907"
				item: "astralsorcery:aquamarine"
				type: "item"
			}]
			size: 0.9d
			tasks: [{
				consume_items: false
				id: "6270C1B96CA3F242"
				item: "astralsorcery:tome"
				type: "item"
			}]
			title: "A 发现：星芒宝典"
			x: 0.0d
			y: 4.5d
		}
		{
			dependencies: ["383340D9B0A5E896"]
			description: [
				"寻找学院遗迹。大型祭坛的浮动聚能水晶可帮助入门，宝箱可能有星图。按手册移除水晶上方遮蔽，让它能接收星光；不要把受保护的遗迹水晶当作可带回家的成品。"
				""
				"手册阶段：A 发现；参照页面：SHRINES。"
			]
			icon: "astralsorcery:rock_collector_crystal"
			id: "71A8CFBE8A60BAB6"
			size: 0.9d
			tasks: [{
				id: "1DC28ECD24473727"
				title: "手动确认：找到祭坛并检查水晶上方遮挡"
				type: "checkmark"
			}]
			title: "学院祭坛与露天水晶"
			x: 3.0d
			y: 7.5d
		}
		{
			dependencies: ["71A8CFBE8A60BAB6"]
			description: [
				"获取并查看星图，研究水平足够时它会揭示星座资料。Shift 打开宝典可存放星图；拿到星图不等于已经在夜空描绘并发现星座。"
				""
				"手册阶段：A 发现；参照页面：CPAPER。"
			]
			icon: "astralsorcery:constellation_paper"
			id: "2D92A6E017B8394C"
			size: 0.9d
