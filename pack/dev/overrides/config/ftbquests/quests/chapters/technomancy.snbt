	quest_links: [ ]
	quests: [
		{
			description: [
				"Technomancy（神秘科技）把神秘时代的源质/灵气与科技能量（FE/EU）连接起来：源质发电机、能量凝聚器等把精华转成电力，节点机器则读取世界中的灵气节点。"
				"本章六区：A 入门与能源，B 精华加工，C 节点与法杖，D 仪式材料，E 存在网络，F 深层 TC 与植物魔法。任务连线表示教学顺序，不是完整配方树。"
				"前置：神秘时代研究（神秘锭/注魔）、GT 起步（真空管/基础电路）。本实例已把它卡在 LV 阶段之后。"
				"物品目标只检查持有，不消耗材料，也不证明机器已成型；运行类请完成正文操作后勾选。"
			]
			icon: "technom:ritual_tome"
			id: "0F71F86BB7942BDF"
			size: 0.9d
			tasks: [{
				id: "76602D6F01BA3F5C"
				title: "已阅读六区导航与前置要求"
				type: "checkmark"
			}]
			title: "A · 神秘科技：精华与能量的桥梁"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["0F71F86BB7942BDF"]
			description: [
				"仪式书是本模组的索引：翻它查看仪式与机器条目。原版用书+荧石+黑染料即可；本实例追加了 GT 真空管，需先进入 GT 阶段。"
				"仪式系统需要先完成神秘时代的注魔与研究，五色水晶与催化器是后续仪式的核心材料。"
				"真正开工前先建一颗稳定的源质来源：空罐接管从灵气罐/炼金炉收集，或用本模组的分解路线取物体要素。"
			]
			icon: "technom:ritual_tome"
			id: "2168C6875D45233B"
			rewards: [{
				count: 2
				id: "043EF2F39881D680"
				item: "numismatics:cog"
