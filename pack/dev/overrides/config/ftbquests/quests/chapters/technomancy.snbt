			}]
			title: "仪式书与源质学入门"
			x: 0.0d
			y: 2.0d
		}
		{
			dependencies: ["0F71F86BB7942BDF"]
			description: [
				"量子罐单方面大容量存一种源质（十只符文罐的容量）。用带要素的容器设过滤，配源质管道进出；顶面接受输入。"
				"量化玻璃与中子化金属是它的门槛，分别来自奥术合成与注魔/坩埚路线。"
				"它向相邻运输方块提供吸气，是精华加工线的基础缓冲；先做成一只再扩产。"
			]
			icon: "technom:quantum_jar"
			id: "01834EF9709B03AD"
			rewards: [{
